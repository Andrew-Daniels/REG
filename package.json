{
  "name": "house-price-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Price Is Fairway - a house-price-guessing party game with golf scoring",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
